#![lint::allow("unused_import")]

load core.utils: cast
load std.itermtool.key: KeyEvent, KEY_TAB
load std.itermtool.mouse: MouseEvent

fun default_focus_key(k: KeyEvent) -> bool {
    return false
}

fun default_focus_mouse(m: MouseEvent) -> bool {
    return false
}

public static FOCUS_STATE_NORMAL: int32 = 0
public static FOCUS_STATE_FOCUSED: int32 = 1
public static FOCUS_STATE_DISABLED: int32 = 2

public class FocusNode {
    public id: string
    public tab_index: int32
    public disabled: bool
    public focused: bool
    public handle_key_fn: fun(KeyEvent) -> bool
    public handle_mouse_fn: fun(MouseEvent) -> bool

    public fun init(id: string, tab_index: int32 = 0, disabled: bool = false) {
        rewrite this.id = id
        rewrite this.tab_index = tab_index
        rewrite this.disabled = disabled
        rewrite this.focused = false
        rewrite this.handle_key_fn = default_focus_key
        rewrite this.handle_mouse_fn = default_focus_mouse
    }

    public fun handle_key(key: KeyEvent) -> bool {
        set f = this.handle_key_fn
        return f(key)
    }

    public fun handle_mouse(m: MouseEvent) -> bool {
        set f = this.handle_mouse_fn
        return f(m)
    }
}

public class FocusManager {
    public nodes: FocusNode[]
    public focused_index: int32

    public fun init() {
        set empty_nodes: FocusNode[] = []
        rewrite this.nodes = empty_nodes
        rewrite this.focused_index = -1
    }

    public fun register(node: FocusNode) {
        for i in 0..this.nodes.len() {
            if this.nodes[i].id == node.id {
                rewrite this.nodes[i] = node
                return
            }
        }
        this.nodes.push(node)
        if this.nodes.len() > 1 {
            for i in 0..this.nodes.len() {
                for j in 0..this.nodes.len() - 1 {
                    if this.nodes[j].tab_index > this.nodes[j + 1].tab_index {
                        set temp = this.nodes[j]
                        rewrite this.nodes[j] = this.nodes[j + 1]
                        rewrite this.nodes[j + 1] = temp
                    }
                }
            }
        }
    }

    public fun unregister(id: string) -> bool {
        set found_index: int32 = -1
        for i in 0..this.nodes.len() {
            if this.nodes[i].id == id {
                rewrite found_index = cast(i, "int32")
            }
        }
        if found_index < 0 {
            return false
        }
        for i in cast(found_index, "int64")..this.nodes.len() - 1 {
            rewrite this.nodes[i] = this.nodes[i + 1]
        }
        this.nodes.pop()
        if this.focused_index == found_index {
            rewrite this.focused_index = -1
        } else {
            if this.focused_index > found_index {
                rewrite this.focused_index = this.focused_index - 1
            }
        }
        return true
    }

    public fun get_focused_node() -> FocusNode? {
        set total = cast(this.nodes.len(), "int32")
        if this.focused_index >= 0 && this.focused_index < total {
            return this.nodes[this.focused_index]
        }
        return null
    }

    public fun get_focused_id() -> string {
        set total = cast(this.nodes.len(), "int32")
        if this.focused_index >= 0 && this.focused_index < total {
            return this.nodes[this.focused_index].id
        }
        return ""
    }

    public fun set_focus(id: string) -> bool {
        set target_idx: int32 = -1
        for i in 0..this.nodes.len() {
            if this.nodes[i].id == id {
                if this.nodes[i].disabled {
                    return false
                }
                rewrite target_idx = cast(i, "int32")
            }
        }
        if target_idx < 0 {
            return false
        }
        for i in 0..this.nodes.len() {
            rewrite this.nodes[i].focused = (cast(i, "int32") == target_idx)
        }
        rewrite this.focused_index = target_idx
        return true
    }

    public fun next() -> string {
        if this.nodes.len() == 0 {
            return ""
        }
        set total = cast(this.nodes.len(), "int32")
        set start: int32 = 0
        if this.focused_index >= 0 {
            rewrite start = (this.focused_index + 1) % total
        }
        for step in 0..total {
            set idx = (start + cast(step, "int32")) % total
            if !this.nodes[idx].disabled {
                if this.focused_index >= 0 && this.focused_index < total {
                    rewrite this.nodes[this.focused_index].focused = false
                }
                rewrite this.nodes[idx].focused = true
                rewrite this.focused_index = idx
                return this.nodes[idx].id
            }
        }
        return ""
    }

    public fun prev() -> string {
        if this.nodes.len() == 0 {
            return ""
        }
        set total = cast(this.nodes.len(), "int32")
        set start: int32 = total - 1
        if this.focused_index >= 0 {
            rewrite start = (this.focused_index - 1 + total) % total
        }
        for step in 0..total {
            set idx = (start - cast(step, "int32") + total * 2) % total
            if !this.nodes[idx].disabled {
                if this.focused_index >= 0 && this.focused_index < total {
                    rewrite this.nodes[this.focused_index].focused = false
                }
                rewrite this.nodes[idx].focused = true
                rewrite this.focused_index = idx
                return this.nodes[idx].id
            }
        }
        return ""
    }

    public fun clear_focus() {
        for i in 0..this.nodes.len() {
            rewrite this.nodes[i].focused = false
        }
        rewrite this.focused_index = -1
    }

    public fun get_state(id: string) -> int32 {
        for i in 0..this.nodes.len() {
            if this.nodes[i].id == id {
                if this.nodes[i].disabled {
                    return FOCUS_STATE_DISABLED
                }
                if this.nodes[i].focused {
                    return FOCUS_STATE_FOCUSED
                }
                return FOCUS_STATE_NORMAL
            }
        }
        return FOCUS_STATE_NORMAL
    }

    public fun handle_key(code: int32, shift: bool) -> bool {
        if code == KEY_TAB {
            if shift {
                this.prev()
            } else {
                this.next()
            }
            return true
        }
        return false
    }

    public fun dispatch_key(k: KeyEvent) -> bool {
        set node = this.get_focused_node()
        if node != null {
            set n = node ?? init FocusNode("")
            if !n.disabled {
                return n.handle_key(k)
            }
        }
        return false
    }

    public fun dispatch_mouse(m: MouseEvent) -> bool {
        set node = this.get_focused_node()
        if node != null {
            set n = node ?? init FocusNode("")
            if !n.disabled {
                return n.handle_mouse(m)
            }
        }
        return false
    }
}
